[Unit]
Description=LankaSaaS PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=lankasaas
Group=lankasaas
WorkingDirectory=/opt/lankasaas
Environment=ENV_FILE=.env.production
Environment=BACKUP_DIR=/var/backups/lankasaas
ExecStart=/usr/bin/env bash /opt/lankasaas/ops/backup.sh
PrivateTmp=true
NoNewPrivileges=true
